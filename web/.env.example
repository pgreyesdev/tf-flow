# Dirección de la API de TF-FLOW vista desde el servidor de la web
TFFLOW_API_URL=http://localhost:8000
# Mismo valor que TFFLOW_ASSISTANT_ACCESS_TOKEN en la API, si se define allí
# TFFLOW_ASSISTANT_TOKEN=
# URL pública de la web, para metadatos, sitemap y enlaces compartidos
TFFLOW_SITE_URL=http://localhost:3000
# Estación y sentido de la previsión de portada (id:sentido); por defecto, la primera
# TFFLOW_FEATURED_STATION=57:1
# Ficha de la app en Google Play; mientras no exista, la web muestra «Próximamente»
# TFFLOW_PLAY_STORE_URL=
# Límite de preguntas al asistente por visitante y minuto en la web
# TFFLOW_ASSISTANT_RATE_LIMIT_PER_MINUTE=6
