# Copia este fichero a .env y ajusta los valores. Nunca subas .env al repositorio.
TFFLOW_ENVIRONMENT=development
TFFLOW_LOG_LEVEL=INFO
TFFLOW_CORS_ORIGINS=["http://localhost:3000"]
# Paquete del modelo y su huella (fichero serving.joblib.sha256 del flujo de entrenamiento).
# TFFLOW_MODEL_PATH=/models/serving.joblib
# TFFLOW_MODEL_SHA256=<64 caracteres hexadecimales>
TFFLOW_MAX_FORECAST_DAYS=14
# Asistente (opcional). Sin clave queda desactivado.
# TFFLOW_OPENAI_API_KEY=
# TFFLOW_ASSISTANT_ACCESS_TOKEN=
TFFLOW_ASSISTANT_DAILY_TOKEN_BUDGET=300000
TFFLOW_DATABASE_URL=postgresql+psycopg://tfflow:tfflow@localhost:5432/tfflow

POSTGRES_USER=tfflow
POSTGRES_PASSWORD=tfflow
POSTGRES_DB=tfflow
